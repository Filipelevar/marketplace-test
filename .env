# Base URL for REST calls. Relative so MSW intercepts it in dev, preview and the deployed demo.
VITE_API_URL=/api

# Socket.IO server URL. With mocks enabled, MSW intercepts it before any network access,
# so the host does not need to exist. A dedicated host keeps it apart from Vite's HMR socket.
VITE_SOCKET_URL=wss://realtime.greenmint.mock

# Starts the MSW worker (REST + Socket.IO mocks) before the app renders.
VITE_ENABLE_MOCKS=true
